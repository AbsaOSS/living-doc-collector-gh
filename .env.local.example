# Configuration of local-integration.sh. Copy this file to `.env.local` (git-ignored) and set TARGET_CHECKOUT.
# As committed, it runs the collector over the public AbsaOSS/living-doc-testbed project `projects/core/`:
#
#   git clone https://github.com/AbsaOSS/living-doc-testbed.git ../living-doc-testbed
#
# One `KEY=value` per line; a line starting with `#` is a comment. Values are taken literally - no variable
# expansion, and no comment after a value. A relative TARGET_CHECKOUT or OUT_DIR resolves against this
# repository's root, and `~/` is the home directory. The script reads no other key: no token, since both modes
# read the local checkout and call no API.

# Written to every artifact's `metadata.source.project_id`: lowercase letters, digits and hyphens.
PROJECT_ID=library-loans

# The target repository: its local checkout, and the GitHub organization and name it has on the server.
TARGET_CHECKOUT=../living-doc-testbed
ORGANIZATION_NAME=AbsaOSS
REPOSITORY_NAME=living-doc-testbed

# Each mode's directories, relative to TARGET_CHECKOUT; several are separated by commas.
# doc-source: User Story feature files (required), Functionality feature files and PageObjects (both optional).
DOC_SOURCE_US_PATHS=projects/core/tests/e2e/features/liv_doc_us
DOC_SOURCE_FUNC_PATHS=projects/core/tests/e2e/features/liv_doc_func
DOC_SOURCE_PAGES_PATHS=projects/core/tests/e2e/pages
# ui-tests: the feature files whose scenarios are mined (required).
UI_TESTS_PATHS=projects/core/tests/e2e/features/liv_doc_us,projects/core/tests/e2e/features/liv_doc_func

# Optional: the GitHub server the target lives on, for `source_ref.url` permalinks; set it for GitHub Enterprise
# Server. Empty means https://github.com.
GITHUB_SERVER_URL=

# Optional: the output root. Each mode writes `$OUT_DIR/collector-gh/<mode>/<mode>.json`; `./output` is git-ignored.
OUT_DIR=./output

# Optional: the Python >= 3.10 the venv is built from. Empty means `python3`, else `python`, from PATH. On Git Bash
# for Windows, `python3` may be the Microsoft Store alias, which does not run: set `PYTHON=python` there.
PYTHON=
