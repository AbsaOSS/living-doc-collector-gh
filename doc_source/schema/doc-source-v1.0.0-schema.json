        "id": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "aspect": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "preconditions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "not_in_scope": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "removal_planned": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
