{
  "$schema_version": "1.0.0",
  "$defs": {
    "Step": {
      "description": "A single Gherkin step within a scenario.",
      "properties": {
        "keyword": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "keyword",
        "text"
      ],
      "title": "Step",
      "type": "object"
    },
    "AcLink": {
      "description": "A scenario-to-AC link, carrying the optional aspect the scenario covers.",
      "properties": {
        "id": {
          "type": "string"
        },
        "aspect": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "aspect"
      ],
      "title": "AcLink",
      "type": "object"
    },
    "ScenarioSource": {
      "description": "Source identity of a scenario.",
      "properties": {
        "org": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        }
      },
      "required": [
        "org",
        "repo",
        "file",
        "line"
      ],
      "title": "ScenarioSource",
      "type": "object"
    },
    "UITestItem": {
      "description": "Represents a single UI test scenario from the collector output.",
      "properties": {
        "id": {
          "type": "string"
        },
        "us_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "func_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ac_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ac_links": {
          "items": {
            "$ref": "#/$defs/AcLink"
          },
          "type": "array"
        },
        "scenario_name": {
          "type": "string"
        },
        "scenario_type": {
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "type": "array"
        },
        "source": {
          "$ref": "#/$defs/ScenarioSource"
        }
      },
      "required": [
        "id",
        "us_id",
        "func_id",
        "ac_ids",
        "scenario_name",
        "scenario_type",
        "tags",
        "steps",
        "source"
      ],
      "title": "UITestItem",
      "type": "object"
    },
    "AdapterMetadataProducer": {
      "description": "Identifies the tool that produced the output file.",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "build": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "version",
        "build"
      ],
      "title": "AdapterMetadataProducer",
      "type": "object"
    },
    "AdapterMetadataRun": {
      "description": "GitHub Actions workflow run information, when available.",
      "properties": {
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_attempt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "actor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "workflow": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "run_id",
        "run_attempt",
        "actor",
        "workflow",
        "ref",
        "sha"
      ],
      "title": "AdapterMetadataRun",
      "type": "object"
    },
    "AdapterMetadataSource": {
      "description": "Source system and repository information.",
      "properties": {
        "systems": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "repositories": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "organization": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "enterprise": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "systems",
        "repositories",
        "organization",
        "enterprise"
      ],
      "title": "AdapterMetadataSource",
      "type": "object"
    },
    "AdapterMetadata": {
      "description": "File-level provenance and audit metadata.",
      "properties": {
        "producer": {
          "$ref": "#/$defs/AdapterMetadataProducer"
        },
        "run": {
          "$ref": "#/$defs/AdapterMetadataRun"
        },
        "source": {
          "$ref": "#/$defs/AdapterMetadataSource"
        },
        "original_metadata": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "producer",
        "run",
        "source",
        "original_metadata"
      ],
      "title": "AdapterMetadata",
      "type": "object"
    },
    "CompatibilityWarning": {
      "description": "A non-fatal compatibility warning surfaced to downstream consumers.",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "CompatibilityWarning",
      "type": "object"
    }
  },
  "title": "UITestsResult",
  "description": "Complete UI test catalog result from the ui-tests collector.",
  "type": "object",
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/UITestItem"
      },
      "type": "array"
    },
    "metadata": {
      "$ref": "#/$defs/AdapterMetadata"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/CompatibilityWarning"
      },
      "type": "array"
    }
  },
  "required": [
    "items",
    "metadata",
    "warnings"
  ]
}
