{
  "$schema_version": "1.0.0",
  "$defs": {
    "AcceptanceCriterion": {
      "description": "A single acceptance-criterion row parsed from an issue body.",
      "properties": {
        "id": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "state",
        "version",
        "description"
      ],
      "title": "AcceptanceCriterion",
      "type": "object"
    },
    "AdapterItemTimestamps": {
      "description": "Creation/update timestamps for an adapter item.",
      "properties": {
        "created": {
          "type": "string"
        },
        "updated": {
          "type": "string"
        }
      },
      "required": [
        "created",
        "updated"
      ],
      "title": "AdapterItemTimestamps",
      "type": "object"
    },
    "AdapterMetadataProducer": {
      "description": "Identifies the tool that produced the output file.",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "build": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "version",
        "build"
      ],
      "title": "AdapterMetadataProducer",
      "type": "object"
    },
    "AdapterMetadataRun": {
      "description": "GitHub Actions workflow run information, when available.",
      "properties": {
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_attempt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "actor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "workflow": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "run_id",
        "run_attempt",
        "actor",
        "workflow",
        "ref",
        "sha"
      ],
      "title": "AdapterMetadataRun",
      "type": "object"
    },
    "AdapterMetadataSource": {
      "description": "Source system and repository information.",
      "properties": {
        "systems": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "repositories": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "organization": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "enterprise": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "systems",
        "repositories",
        "organization",
        "enterprise"
      ],
      "title": "AdapterMetadataSource",
      "type": "object"
    },
    "AdapterMetadata": {
      "description": "File-level provenance and audit metadata.",
      "properties": {
        "producer": {
          "$ref": "#/$defs/AdapterMetadataProducer"
        },
        "run": {
          "$ref": "#/$defs/AdapterMetadataRun"
        },
        "source": {
          "$ref": "#/$defs/AdapterMetadataSource"
        },
        "original_metadata": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "producer",
        "run",
        "source",
        "original_metadata"
      ],
      "title": "AdapterMetadata",
      "type": "object"
    },
    "CompatibilityWarning": {
      "description": "A non-fatal compatibility warning surfaced to downstream consumers.",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "CompatibilityWarning",
      "type": "object"
    },
    "AdapterItem": {
      "description": "A single consolidated issue enriched with parsed body sections.",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "url": {
          "type": "string"
        },
        "timestamps": {
          "$ref": "#/$defs/AdapterItemTimestamps"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "business_value": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "preconditions": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "acceptance_criteria": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/AcceptanceCriterion"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "title",
        "state",
        "tags",
        "url",
        "timestamps"
      ],
      "title": "AdapterItem",
      "type": "object"
    }
  },
  "title": "AdapterResult",
  "description": "Complete result from adapter parsing.",
  "type": "object",
  "properties": {
    "user_stories": {
      "items": {
        "$ref": "#/$defs/AdapterItem"
      },
      "type": "array"
    },
    "metadata": {
      "$ref": "#/$defs/AdapterMetadata"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/CompatibilityWarning"
      },
      "type": "array"
    }
  },
  "required": [
    "user_stories",
    "metadata",
    "warnings"
  ]
}
